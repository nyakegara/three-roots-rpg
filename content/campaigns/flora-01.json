  "quests": [
    {
      "id": "guide-introduction",
      "title": "Весть с соседнего острова",
      "pointOfInterestId": "guide-dialogue",
      "narrative": "Кабачок-проводник: Лиара, люди уже высадились на нашем берегу. Они хотят выжечь лес и занять остров. Крестьяне на пастбище просят помощи, а дальше путь на север заперт. Грибной аванпост тоже в опасности.",
      "choices": [
        {
          "id": "begin",
          "description": "Выслушать проводника и защитить остров.",
          "goldChange": 0,
          "reputationChange": 0
        }
      ]
    },
    {
      "id": "pasture-choice",
      "title": "Спор на пастбище",
      "pointOfInterestId": "pasture-request",
      "narrative": "Крестьяне просят выгнать растения, которые нападают на их стада. За помощь они откроют наём крестьян. Можно отказать и прогнать людей: рощи это одобрят. После победы станет известна безопасная тропа в выжженный северный лес.",
      "choices": [
        {
          "id": "help",
          "description": "Помочь крестьянам. Сразиться с растениями; после победы станет доступен найм крестьян.",
          "goldChange": 0,
          "reputationChange": 0
        },
        {
          "id": "refuse",
          "description": "Отказать людям и прогнать их. После победы репутация флоры повысится на 1.",
          "goldChange": 0,
          "reputationChange": 0
        }
      ]
    },
    {
      "id": "artifact-ash-quest",
      "title": "Пепельный оберег",
      "pointOfInterestId": "artifact-ash",
      "narrative": "Среди обугленных корней лежит древний оберег. Его охраняет отряд людей.",
      "choices": [
        {
          "id": "claim",
          "description": "Вызвать стража на бой. После победы оберег принесёт 75 золота.",
          "goldChange": 0,
          "reputationChange": 0
        },
        {
          "id": "leave",
          "description": "Оставить реликвию в покое.",
          "goldChange": 0,
          "reputationChange": 0
        }
      ]
    },
    {
      "id": "artifact-spore-quest",
      "title": "Споровый венец",
      "pointOfInterestId": "artifact-spore",
      "narrative": "В старой грибной роще спрятан споровый венец. Его страж не подпускает путников.",
      "choices": [
        {
          "id": "claim",
          "description": "Вызвать стража на бой. После победы венец принесёт 90 золота.",
          "goldChange": 0,
